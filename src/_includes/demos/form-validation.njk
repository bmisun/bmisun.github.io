  {% set idSuffix = idSuffix | default("") %}
  <form id="signup-form{{ idSuffix }}" class="form" novalidate>
    <div class="form__field">
      <div>
        <label for="name{{ idSuffix }}">이름</label>
        <input type="text" id="name{{ idSuffix }}" aria-describedby="name{{ idSuffix }}-error" required minlength="2" />
      </div>
      <span id="name{{ idSuffix }}-error" role="alert" class="form__error"></span>
    </div>
    <div class="form__field">
      <div>
        <label for="email{{ idSuffix }}">이메일</label>
        <input type="email" id="email{{ idSuffix }}" aria-describedby="email{{ idSuffix }}-error" required />
      </div>
      <span id="email{{ idSuffix }}-error" role="alert" class="form__error"></span>
    </div>
    <div class="form__field">
      <div>
        <label for="userID{{ idSuffix }}">아이디</label>
        <input type="text" id="userID{{ idSuffix }}" aria-describedby="userID{{ idSuffix }}-error" />
      </div>
      <span id="userID{{ idSuffix }}-error" role="alert" class="form__error"></span>
    </div>
    <div class="form__field">
      <div>
        <label for="userPW{{ idSuffix }}">비밀번호</label>
        <input type="password" id="userPW{{ idSuffix }}" aria-describedby="userPW{{ idSuffix }}-error" />
        <input type="password" id="userPWconfirm{{ idSuffix }}" aria-describedby="userPWconfirm{{ idSuffix }}-error" />
      </div>
      <span id="userPW{{ idSuffix }}-error" role="alert" class="form__error"></span>
      <span id="userPWconfirm{{ idSuffix }}-error" role="alert" class="form__error"></span>
    </div>
    <div class="form__field">
      <div>
        <textarea id="bio{{ idSuffix }}" minlength="5" maxlength="10" required aria-describedby="bio{{ idSuffix }}-error"></textarea>
      </div>
      <span id="bio{{ idSuffix }}-error" role="alert" class="form__error"></span>
    </div>
    <div class="form__actions">
      <button type="reset" class="btn btn--outline">취소</button>
      <button type="submit" class="btn">확인</button>
    </div>
  </form>
